---
import '../styles/layers.css'
import '../styles/custom-properties.css'
import '../styles/reset.css'
import Nav from '../components/Nav.astro'

interface Props {
    title?: string
    description?: string
    publishedDate?: Date
    tags?: string[]
}

const siteTitle = 'Anton Ball dot dev'
const defaultDescription = 'Frontend development and CSS insights from Anton'

const { title, description = defaultDescription, publishedDate, tags } = Astro.props
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f47100" />

        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={publishedDate ? 'article' : 'website'} />
        {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
        {publishedDate && <meta property="article:author" content="Anton Ball" />}
        {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        <meta property="og:image" content={new URL('/ogimage.png', Astro.site)} />
        <meta property="og:image:alt" content={siteTitle} />

        <title>{pageTitle}</title>
        <slot name="head" />
    </head>
    <body>
        <Nav siteTitle={siteTitle} />
        <slot />
    </body>
</html>

<style>
    @layer layout {
        body {
            display: grid;
            grid-template-columns: [overflow-start gutter-start] minmax(var(--space-2), 1fr) [gutter-end main-start] minmax(0, calc(var(--measure) * 1.25)) [main-end gutter-right-start] minmax(var(--space-2), 1fr) [overflow-end gutter-right-end];
            grid-auto-rows: min-content;
            margin-block-start: 0;
        }

        :global(body > *) {
            display: grid;
            grid-template-columns: subgrid;
            grid-column: main;
        }

    }
</style>

<style is:global>
    @layer utilities {
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    }

</style>
