---
import type { Property } from 'csstype'
import type { Space } from '../types/space'
import type { HTMLAttributes, HTMLTag } from 'astro/types'

type Props = HTMLAttributes<HTMLTag> & {
    justify?: Property.JustifyContent
    align?: Property.AlignItems
    space?: Space
    element?: HTMLTag
}

const {
    justify = 'flex-start',
    align = 'flex-start',
    space: spaceStyle = '1',
    element: Element = 'div',
    class: className,
    ...rest
} = Astro.props

const space = `var(--space-${spaceStyle}, var(--space-1, 1rem))`
---

<Element
    style={`--justify: ${justify}; --align: ${align}; --space: ${space};`}
    {...rest}
    class:list={['cluster', className]}
>
    <slot />
</Element>

<style>
    @layer components {
        .cluster {
            display: flex;
            flex-wrap: wrap;
            justify-content: var(--justify);
            align-items: var(--align);
            gap: var(--space);
        }
    }
</style>
