---
import type { HTMLTag } from 'astro/types'
import type { Space } from '../types/space'

interface Props {
    space?: Space
    recursive?: boolean
    element?: HTMLTag
    class?: string
}

const { recursive = false, element: Element = 'div', space, class: className } = Astro.props
---

<Element
    class:list={['stack', { recursive }, className]}
    style={`--space: var(--space-${space}, var(--space-0, 1.5rem));`}
>
    <slot />
</Element>

<style>
    @layer components {
        .stack {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            background-color: var(--background-color);
            color: var(--foreground-color);
        }

        .stack > * {
            margin-block: 0;
        }

        .stack > * + *,
        .stack.recursive * + * {
            margin-block-start: var(--space, var(--space-0, 1.5rem));
        }

        /* Todo: make this dynamic for all space custom properties */
        .stack-exception,
        .stack-exception + * {
            --space: var(--space-3);
        }
    }
</style>
